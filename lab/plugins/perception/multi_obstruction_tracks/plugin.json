{
  "schema": "automa_lab_perception_plugin_v0",
  "id": "multi_obstruction_tracks",
  "name": "Multi-obstruction temporal tracks",
  "description": "Suppress lower-frame floor/background regions by image position and shape, associate multiple generic obstruction regions, and expose bounded track evidence.",
  "plugin": {
    "entrypoint": "lab.plugins.perception.multi_obstruction_tracks.src.plugin:MultiObstructionTracksPlugin",
    "config": {
      "max_tracks": 2,
      "floor_cutoff_y": 0.50,
      "minimum_object_height": 0.14,
      "minimum_object_area_fraction": 0.006,
      "maximum_object_area_fraction": 0.30,
      "association_distance": 0.35,
      "minimum_association_score": 0.12,
      "smoothing_alpha": 0.35,
      "max_missed_frames": 2,
      "reacquire_window_frames": 4,
      "minimum_feature_points": 6,
      "canny_low": 30,
      "canny_high": 45,
      "minimum_contour_area_fraction": 0.003,
      "maximum_contour_area_fraction": 0.25,
      "contour_merge_gap": 0.08,
      "contrast_normalization": "none",
      "contrast_clip_limit": 2.0,
      "contrast_tile_size": 8,
      "contrast_gamma": 1.0,
      "preserve_separate_proposals": false,
      "duplicate_suppression_iou": 0.08,
      "output_bbox_shrink_x": 1.0,
      "output_bbox_shrink_y": 1.0,
      "minimum_output_confidence": 0.0
    }
  },
  "inputs": [
    {
      "name": "frame",
      "component_id": "camera.rgb:front_camera",
      "provider_spec": "implementations.perception.components.camera:provide_camera_frame"
    }
  ],
  "runtime": {
    "python": "core"
  },
  "output": {
    "schema": "perception_text_v2",
    "kind": "obstacle",
    "semantic_labels": false,
    "depth": false
  }
}
