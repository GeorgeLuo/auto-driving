{
  "default": {
    "preset": "lightweight_observer"
  },
  "presets": {
    "lightweight_observer": {
      "description": "Lightweight perception: frame facts, visible floor, and first-hit floor boundaries.",
      "plugins": [
        "frame",
        "floor_plane"
      ]
    },
    "sim_debug": {
      "description": "Diagnostic, simulator-only: frame facts plus known Chase color-target signals. Not a driving preset.",
      "plugins": [
        "frame",
        "sim_color_targets"
      ]
    },
    "chase-v1-detect-by-color": {
      "description": "Chase simulator cardboard: color-based obstacle boxes, then identities kept across frames in shared memory.",
      "plugins": [
        "sim_cardboard_obstacle",
        "sim_cardboard_permanence"
      ]
    },
    "visual_observer": {
      "description": "Diagnostic visual observer: frame facts, floor and traversability, and bounded scene-motion tracks. Not a driving preset.",
      "plugins": [
        "frame",
        "floor_plane",
        "motion_tracks"
      ]
    },
    "multi_obstruction": {
      "description": "Multi-obstruction tracks across frames, with floor continuity and classical color regions.",
      "plugins": [
        "multi_obstruction_tracks",
        "floor_continuity",
        "classical_regions"
      ]
    },
    "obstruction_observer": {
      "description": "Generic obstruction observer: frame facts, a fixed image cut-off on tracks, and bounded multi-region temporal tracks.",
      "plugins": [
        "frame",
        "floor_plane",
        "multi_obstruction_tracks"
      ],
      "plugin_configs": {
        "multi_obstruction_tracks": {
          "max_tracks": 4,
          "floor_cutoff_y": 0.72,
          "minimum_object_height": 0.1,
          "minimum_object_area_fraction": 0.006,
          "maximum_object_area_fraction": 0.6,
          "association_distance": 0.35,
          "minimum_association_score": 0.12,
          "smoothing_alpha": 0.35,
          "max_missed_frames": 2,
          "reacquire_window_frames": 4,
          "minimum_feature_points": 6,
          "canny_low": 20,
          "canny_high": 40,
          "minimum_contour_area_fraction": 0.0015,
          "maximum_contour_area_fraction": 0.25,
          "contour_merge_gap": 0.16
        }
      }
    },
    "capture_floor": {
      "description": "Stricter floor-boundary settings calibrated against the archived chase-stream-depth-obstacles-decision-30s-20260829-0436-retry capture. Retains boundaries with at least 0.70 confidence and 0.03 image width. Results are representation evidence, not semantic accuracy.",
      "plugins": [
        "floor_continuity"
      ],
      "plugin_configs": {
        "floor_continuity": {
          "minimum_boundary_width_ratio": 0.03,
          "minimum_boundary_confidence": 0.7
        }
      }
    },
    "object_separated_fusion": {
      "description": "Composite box fusion with recursive spatial-mode separation between objects.",
      "plugins": [
        "composite_box_fusion"
      ],
      "plugin_configs": {
        "composite_box_fusion": {
          "object_separated_geometry": true
        }
      }
    }
  },
