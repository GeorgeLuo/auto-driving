+class AutonomyAPIBase(RequestHandler):
+    def write_json(self, payload: dict, status: int = 200):
+        self.set_status(status)
+        self.set_header("Content-Type", "application/json")
+        self.write(json.dumps(payload, sort_keys=True))
+
+    def read_json_body(self) -> dict:
+        if not self.request.body:
+            return {}
+        return tornado.escape.json_decode(self.request.body)
+
+    def status_payload(self) -> dict:
+        from implementations.runtime.picar.control import DRIVE_MODES
+        host = getattr(self.application, "autonomy_host", None)
+        autonomy_status = None if host is None else host.status()
+        return {
+            "ok": host is not None,
+            "drive_mode": getattr(self.application, "mode", None),
+            "autonomy_modes": sorted(DRIVE_MODES),
+            "drive_mode_map": DRIVE_MODES,
+            "autonomy": autonomy_status,
+        }
+
+
+class AutonomyStatusAPI(AutonomyAPIBase):
+    def get(self):
+        self.write_json(self.status_payload())
+
+
+class AutonomyObservationLatestAPI(AutonomyAPIBase):
+    """Publish one exact latest observation snapshot without history or disk writes."""
+
+    def get(self):
+        publisher = getattr(self.application, "observation_publisher", None)
+        if publisher is None or not hasattr(publisher, "publish_latest"):
+            self.write_json(
+                {
+                    "schema": "automa_physical_observation_publication_v0",
+                    "ok": False,
+                    "health": "absent",
+                    "error": "observation publisher is not available",
+                    "drive_mode": getattr(self.application, "mode", None),
+                },
+                status=503,
+            )
+            return
+
+        payload = publisher.publish_latest()
+        payload["drive_mode"] = getattr(self.application, "mode", None)
+        status_code = 200
+        if payload.get("health") == "absent":
+            status_code = 503
+        elif payload.get("health") == "warming":
+            status_code = 200
+        self.write_json(payload, status=status_code)
+
+
+class AutonomyObservationLatestFrameAPI(AutonomyAPIBase):
+    """Serve the exact processed JPEG that matches the latest observation snapshot."""
+
+    def get(self):
+        publisher = getattr(self.application, "observation_publisher", None)
+        if publisher is None or not hasattr(publisher, "publish_latest_frame_jpeg"):
+            self.set_status(503)
+            self.set_header("Content-Type", "application/json")
+            self.write(
+                json.dumps(
+                    {
+                        "ok": False,
+                        "health": "absent",
+                        "error": "observation publisher is not available",
+                    },
+                    sort_keys=True,
+                )
+            )
+            return
+
+        jpeg, meta = publisher.publish_latest_frame_jpeg()
+        frame = meta.get("frame") if isinstance(meta, dict) else None
+        frame_id = None if not isinstance(frame, dict) else frame.get("frame_id")
+        if frame_id is None and isinstance(meta, dict):
+            frame_id = meta.get("frame_id")
+        if jpeg is None:
+            self.set_status(503)
+            self.set_header("Content-Type", "application/json")
+            self.set_header("Cache-Control", "no-store")
+            if frame_id is not None:
+                self.set_header("X-Frame-Id", str(frame_id))
+            if isinstance(meta, dict) and meta.get("health") is not None:
+                self.set_header("X-Observation-Health", str(meta.get("health")))
+            self.write(json.dumps(meta, sort_keys=True, default=str))
+            return
+
+        self.set_header("Content-Type", "image/jpeg")
+        self.set_header("Content-Length", str(len(jpeg)))
+        self.set_header("Cache-Control", "no-store")
+        if frame_id is not None:
+            self.set_header("X-Frame-Id", str(frame_id))
+        if isinstance(meta, dict):
+            if meta.get("frame_index") is not None:
+                self.set_header("X-Frame-Index", str(meta.get("frame_index")))
+            elif isinstance(frame, dict) and frame.get("frame_index") is not None:
+                self.set_header("X-Frame-Index", str(frame.get("frame_index")))
+            if meta.get("health") is not None:
+                self.set_header("X-Observation-Health", str(meta.get("health")))
+            captured = meta.get("captured_at_ms")
+            if captured is None and isinstance(frame, dict):
+                captured = frame.get("captured_at_ms")
+            if captured is not None:
+                self.set_header("X-Captured-At-Ms", str(captured))
+            completed = meta.get("completed_at_ms")
+            if completed is None and isinstance(frame, dict):
+                completed = frame.get("completed_at_ms")
+            if completed is not None:
+                self.set_header("X-Completed-At-Ms", str(completed))
+        self.write(jpeg)
+
