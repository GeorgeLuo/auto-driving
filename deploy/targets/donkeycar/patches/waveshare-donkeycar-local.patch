+class AutonomyRuntimeAPI(AutonomyAPIBase):
+    """Lifecycle transport; the shared host owns authority and application."""
+
+    def get(self):
+        publisher = getattr(self.application, "observation_publisher", None)
+        if publisher is None:
+            self.write_json({"ok": False, "error": "runtime unavailable"}, status=503)
+            return
+        self.write_json({
+            "ok": True,
+            "host_run_id": publisher.run_id,
+            "session": publisher.host.session_status(),
+        })
+
+    def post(self):
+        from autonomy.runtime.session import RunConfiguration
+        publisher = getattr(self.application, "observation_publisher", None)
+        if publisher is None:
+            self.write_json({"ok": False, "error": "runtime unavailable"}, status=503)
+            return
+        data = self.read_json_body()
+        command = data.get("command")
+        try:
+            # The publisher sets Donkey's drive mode for the runs it starts and stops.
+            if command == "run":
+                publisher.start(RunConfiguration(**data.get("configuration", {})), record=data.get("record", False))
+            elif command == "read_recording":
+                recording = publisher.host.recording
+                if recording is None:
+                    raise ValueError("no recorded run is available")
+                self.write_json({"ok": True, "recording": recording.read(run_id=data.get("run_id"), after=data.get("after"))})
+                return
+            elif command in {"stop", "restart"}:
+                publisher.stop()
+            else:
+                raise ValueError(f"unknown runtime command {command!r}")
+            self.get()
+            if command == "restart":
+                # The deployed systemd service restarts this host. SIGINT runs
+                # Donkey's shutdown hooks, including the shared runtime stop.
+                import os
+                import signal
+                tornado.ioloop.IOLoop.current().call_later(
+                    0.2, lambda: os.kill(os.getpid(), signal.SIGINT)
+                )
+        except (TypeError, ValueError, RuntimeError) as exc:
+            self.write_json({"ok": False, "error": str(exc)}, status=400)
+
+
+class AutonomyModeAPI(AutonomyRuntimeAPI):
+    """Compatibility transport for existing mode callers; same host lifecycle."""
+
+    def post(self):
+        from autonomy.runtime.session import RunConfiguration
+        data = self.read_json_body()
+        publisher = getattr(self.application, "observation_publisher", None)
+        if publisher is None:
+            self.write_json({"ok": False, "error": "runtime unavailable"}, status=503)
+            return
+        try:
+            mode = data.get("mode")
+            if mode == "manual":
+                publisher.stop()
+            else:
+                publisher.start(RunConfiguration(mode=mode))
+            self.get()
+        except (TypeError, ValueError, RuntimeError) as exc:
+            self.write_json({"ok": False, "error": str(exc)}, status=400)
+
+
+class AutonomyMemoryResetAPI(AutonomyAPIBase):
+    """Reset the activated memory step without restarting the Donkey process."""
+
+    def post(self):
+        publisher = getattr(self.application, "observation_publisher", None)
+        if publisher is None or not hasattr(publisher, "reset_memory"):
+            self.write_json(
+                {
+                    "schema": "automa_memory_reset_v0",
+                    "ok": False,
+                    "status": "absent",
+                    "error": "memory reset is not available (observation publisher missing reset_memory)",
+                    "drive_mode": getattr(self.application, "mode", None),
+                },
+                status=503,
+            )
+            return
+
+        result = publisher.reset_memory()
+        if not isinstance(result, dict):
+            self.write_json(
+                {
+                    "schema": "automa_memory_reset_v0",
+                    "ok": False,
+                    "status": "error",
+                    "error": "reset_memory returned a non-object payload",
+                },
+                status=500,
+            )
+            return
+
+        payload = {
+            "schema": "automa_memory_reset_v0",
+            "drive_mode": getattr(self.application, "mode", None),
+            **result,
+        }
+        # Include live autonomy status so operators can confirm empty epoch/counts.
+        host = getattr(self.application, "autonomy_host", None)
+        if host is not None:
+            autonomy = host.status()
+            payload["autonomy"] = autonomy
