cmake_minimum_required(VERSION 3.24)

set(layers core scene physics render sensor server)
set(deps_core "")
set(deps_scene core)
set(deps_physics scene core)
set(deps_render scene core)
set(deps_sensor core)
set(deps_server physics render sensor scene)

file(GLOB_RECURSE sources RELATIVE "${source_dir}"
  "${source_dir}/*.cpp" "${source_dir}/*.hpp" "${source_dir}/*.h")
foreach(path IN LISTS sources)
  string(REGEX MATCH "^[^/]+" layer "${path}")
  if(NOT layer IN_LIST layers)
    message(FATAL_ERROR "Unclassified native source: ${path}")
  endif()
  get_filename_component(directory "${source_dir}/${path}" DIRECTORY)
  file(STRINGS "${source_dir}/${path}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
  foreach(line IN LISTS includes)
    if(NOT line MATCHES "^[ \t]*#[ \t]*include[ \t]*([<\"])([^>\"]+)[>\"]")
      continue()
    endif()
    set(delimiter "${CMAKE_MATCH_1}")
    set(header "${CMAKE_MATCH_2}")
    if(delimiter STREQUAL "\"" AND EXISTS "${directory}/${header}")
      file(REAL_PATH "${directory}/${header}" resolved)
    elseif(EXISTS "${source_dir}/${header}")
      file(REAL_PATH "${source_dir}/${header}" resolved)
    elseif(delimiter STREQUAL "\"")
      message(FATAL_ERROR "Unresolved local include: ${path} -> ${header}")
    else()
      continue()
    endif()

    file(RELATIVE_PATH dependency "${source_dir}" "${resolved}")
    string(REGEX MATCH "^[^/]+" dependency_layer "${dependency}")
    if(NOT dependency_layer STREQUAL layer AND NOT dependency_layer IN_LIST deps_${layer})
      message(FATAL_ERROR "Forbidden native include: ${path} -> ${dependency}")
    endif()
    if(dependency MATCHES "^render/([^/]+)/")
      set(backend "${CMAKE_MATCH_1}")
      if(NOT layer STREQUAL "server" AND NOT path MATCHES "^render/${backend}/")
        message(FATAL_ERROR "Renderer implementation include: ${path} -> ${dependency}")
      endif()
    endif()
  endforeach()
endforeach()
