+class AutonomyPluginCatalogAPI(AutonomyAPIBase):
+    """Transport only; every host uses the shared catalog registration code."""
+
+    def _catalog(self, payload=None):
+        from autonomy.runtime.plugin_catalog import PluginCatalogAPI
+        host = getattr(self.application, "autonomy_host", None)
+        if host is None:
+            self.write_json({"ok": False, "error": "catalog unavailable"}, status=503)
+            return
+        result = PluginCatalogAPI(host.catalog)(payload)
+        self.write_json(result, status=200 if result.get("ok") else 400)
+
+    def get(self):
+        self._catalog()
+
+    def post(self):
+        self._catalog(self.read_json_body())
