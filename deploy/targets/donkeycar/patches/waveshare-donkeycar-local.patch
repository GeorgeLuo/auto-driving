+        records = None if publisher is None else getattr(publisher, "records", None)
+        query = self._query()
+        if not callable(records):
+            self.write_json(
+                {
+                    "schema": "automa_host_boundary_telemetry_v0",
+                    "ok": False,
+                    "status": "unavailable",
